<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jai.trips-colima-ci</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>colima start ci --activate=false &amp;&amp; colima ssh -p ci -- sudo systemctl restart runner &lt; /dev/null</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/jai/Library/Logs/trips-colima-ci.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jai/Library/Logs/trips-colima-ci.log</string>
</dict>
</plist>
